{
  "version": "0.3.3-rc.1",
  "type": "module",
  "license": "MIT",
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-api-remotes": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.3",
    "@deepseek-ai/dsh-typert-generator": "0.2.1-rc.3",
    "@deepseek-ai/dsh-typert-registry": "0.2.1-rc.3",
    "@types/react": "18.3.31",
    "@types/react-dom": "^18.3.7",
    "esbuild": "0.28.2",
    "lightningcss": "1.33.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@deepseek-ai/dsh-api-session-controller": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-session": "0.2.1-rc.3",
    "react-resizable-panels": "4.14.5"
  },
  "name": "kaitu-novel-workspace-source",
  "description": "开图小说工作台：只读 Markdown、写作交接与有来源的资料提案",
  "scripts": {
    "build": "node ../../scripts/build-novel-plugins.mjs novel-plugin",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit"
  },
  "dependencies": {
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.3",
    "@kaitu/core": "workspace:*",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./dist/client.js"
    },
    "./package.json": "./package.json",
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    }
  },
  "files": [
    "dist",
    "lib/types",
    "lib/typert.host.js",
    "lib/typert.remote-client.js",
    "README.md",
    "LICENSE",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.d.ts"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-api-session-controller"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Stahl-G/rensheng-kaitu.git",
    "directory": "packages/novel-plugin"
  }
}
