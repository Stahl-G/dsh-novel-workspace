{
  "name": "kaitu-oh-story-source",
  "version": "0.4.0-alpha.1",
  "private": true,
  "description": "开图小说工作台：基于 Oh Story 的独立开发版",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.9.0"
  },
  "scripts": {
    "dev": "pnpm build:dsh-plugin",
    "build:dsh-plugin": "pnpm --filter kaitu-novel-workspace build",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint . --max-warnings=0",
    "test": "pnpm test:book && pnpm test:unit",
    "test:unit": "pnpm -r --if-present test",
    "test:contract": "pnpm -r --if-present test:contract",
    "test:dsh": "pnpm test:dsh:native",
    "test:dsh:native": "tsx scripts/native-dsh-smoke.ts",
    "test:dsh:real": "tsx scripts/native-dsh-real.ts",
    "test:release": "node --test scripts/release.test.mjs",
    "test:upstream-updates": "node --test scripts/upstream-updates.test.mjs",
    "upstream:updates": "node scripts/upstream-updates.mjs --dry-run",
    "demo": "tsx scripts/render-workbench-demo.ts all",
    "demo:story": "tsx scripts/render-workbench-demo.ts story",
    "demo:drama": "tsx scripts/render-workbench-demo.ts drama",
    "demo:game": "tsx scripts/render-workbench-demo.ts game",
    "demo:video": "tsx scripts/render-workbench-demo.ts video",
    "assets:sync": "pnpm assets:sync:story && pnpm assets:sync:drama && pnpm assets:sync:game && pnpm assets:sync:video",
    "assets:sync:story": "tsx scripts/sync-oh-story-assets.ts",
    "assets:sync:drama": "tsx scripts/sync-drama-assets.ts",
    "assets:sync:game": "tsx scripts/sync-novel-to-game-assets.ts",
    "assets:sync:video": "tsx scripts/sync-video-recap-assets.ts",
    "assets:check": "tsx scripts/check-upstream-parity.ts && tsx scripts/check-drama-parity.ts && tsx scripts/check-novel-to-game-parity.ts && tsx scripts/check-video-recap-parity.ts",
    "dsh:boundary": "tsx scripts/check-dsh-boundary.ts",
    "verify": "pnpm lint && pnpm typecheck && pnpm assets:check && pnpm dsh:boundary && pnpm test:release && pnpm test:upstream-updates && pnpm test:book && pnpm test:unit && pnpm build",
    "verify:portable": "pnpm typecheck && pnpm assets:check && pnpm test:release && pnpm test:book && pnpm test:unit && pnpm build",
    "verify:release": "pnpm verify && pnpm test:dsh && pnpm test:dsh:rc && pnpm test:dsh:next",
    "test:dsh:rc": "tsx scripts/native-dsh-smoke.ts 0.2.0-rc.2",
    "test:dsh:next": "tsx scripts/native-dsh-smoke.ts 0.2.2-rc.3",
    "pack:preview": "pnpm --filter kaitu-novel-workspace pack --pack-destination dist",
    "test:book": "node --test scripts/kaitu-book.test.mjs scripts/kaitu-author-loop.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "25.5.0",
    "esbuild": "0.28.2",
    "eslint": "10.8.1",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11"
  }
}
